# =============================================================================
# Clinical Protocol Hub — environment variables
# =============================================================================
# All variables are OPTIONAL. With none set, the app runs in MOCK MODE using
# local TypeScript data (src/lib/data/mock-data.ts). Set the Supabase vars
# below to switch to SUPABASE MODE automatically.
# -----------------------------------------------------------------------------

# Supabase project URL (e.g. https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Enables the /admin area. In this MVP admin access is a simple flag (no real
# auth). Set to "true" to expose admin features. Defaults to enabled in dev.
NEXT_PUBLIC_ENABLE_ADMIN=true
